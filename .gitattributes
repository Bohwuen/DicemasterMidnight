# Normalizar finales de línea en el repositorio a LF
# Git convertira a CRLF en checkout en Windows automaticamente
* text=auto eol=lf

# Forzar LF en archivos de texto del addon
*.lua text eol=lf
*.toc text eol=lf
*.xml text eol=lf
*.md  text eol=lf

# Tratar como binarios (no convertir finales de linea)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.blp binary
*.ogg binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.zip binary
*.7z binary
